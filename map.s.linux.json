{
    ">": "inc %rsi",
    "<": "dec %rsi",
    "+": "incb (%rsi)",
    "-": "decb (%rsi)",
    ".": [  "mov $1,%rax",
            "mov $1,%rdi",
            "mov $1,%rdx",
            "syscall" ],
    ",": [  "movb $0,(%rsi)",
            "mov $0,%rax",
            "mov $0,%rdi",
            "mov $1,%rdx",
            "syscall" ],
    "[": [  "openlabel:",
            "cmpb $0,(%rsi)",
            "jz closelabel" ],
    "]": [  "jmp openlabel",
            "closelabel:" ]
}
